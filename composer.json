{
    "name": "devtrope/profanity-filter",
    "description": "Lightweight and customizable PHP package for detecting and censoring profanity in text.",
    "type": "library",
    "keywords": ["profanity", "filter", "ban", "swear"],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Devtrope\\ProfanityFilter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "authors": [
        {
            "name": "Quentin SCHIFFERLE",
            "email": "dev.trope@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
